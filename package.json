{
  "name": "mediacenter",
  "version": "2.1.0",
  "description": "MediaCenter Desktop Application",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:all": "electron-builder --win"
  },
  "build": {
    "appId": "com.mediacenter.portable",
    "productName": "MediaCenter",
    "copyright": "MediaCenter Portable v2.0",
    "asar": false,
    "files": [
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "./app",
        "to": "app",
        "filter": ["**/*", "!node_modules/**"]
      }
    ],
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis",     "arch": ["x64"] }
      ],
      "icon": "build-resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MediaCenter"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
