{
  "name": "mediacenter",
  "productName": "MediaCenter",
  "version": "3.4.0",
  "description": "MediaCenter – portables Medien- und Spielecenter (Filme, Serien, Musik, Fotos, Spiele, LAN-Multiplayer)",
  "author": "Richbert0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Richbert0/MediaStick.git"
  },
  "homepage": "https://github.com/Richbert0/MediaStick",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/cli.js",
    "test": "node --test test/*.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win portable --x64",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:dir": "electron-builder --dir"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mediacenter.portable",
    "productName": "MediaCenter",
    "copyright": "MediaCenter Portable",
    "asar": true,
    "files": [
      "electron-main.js",
      "preload.js",
      "server/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app",
        "filter": [
          "**/*",
          "!media/**",
          "!api/**",
          "!**/node_modules/**",
          "!**/*.log",
          "!**/*.pid",
          "!**/*.port",
          "!**/__pycache__/**",
          "!**/*.py",
          "!**/*.pyc",
          "!games/server.js",
          "!games/package*.json"
        ]
      }
    ],
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png",
      "category": "AudioVideo",
      "synopsis": "Portables Medien- und Spielecenter",
      "desktop": {
        "entry": {
          "Name": "MediaCenter",
          "Comment": "Portables Medien- und Spielecenter",
          "StartupWMClass": "MediaCenter"
        }
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-x86_64.AppImage"
    },
    "extraMetadata": {
      "desktopName": "mediacenter.desktop"
    }
  }
}
