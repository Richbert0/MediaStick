<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath-Artefakt-Konfiguration für MediaCenter.
  Diesen Inhalt im SignPath-Projekt unter "Artifact Configurations" einfügen.
  Das GitHub-Artefakt ist ein ZIP mit der portablen EXE; signiert wird die EXE (Authenticode).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="MediaCenter-*-portable.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
